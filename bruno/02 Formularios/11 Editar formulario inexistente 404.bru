meta {
  name: Editar formulario inexistente (404)
  type: http
  seq: 11
}

put {
  url: {{baseUrl}}/api/formularios/no-existe-123
  body: json
  auth: bearer
}

headers {
  Origin: {{origin}}
}

auth:bearer {
  token: {{idToken}}
}

body:json {
  {
    "titulo": "Inscripción al club",
    "descripcion": "Formulario de prueba creado desde Bruno",
    "campos": [
      {
        "id": "nombre",
        "tipo": "texto",
        "etiqueta": "Nombre",
        "obligatorio": true,
        "opciones": [],
        "reglas": {
          "min": 2,
          "max": 80,
          "patron": null
        },
        "visible_si": null
      },
      {
        "id": "edad",
        "tipo": "numero",
        "etiqueta": "Edad",
        "obligatorio": false,
        "opciones": [],
        "reglas": {
          "min": 10,
          "max": 99,
          "patron": null
        },
        "visible_si": null
      },
      {
        "id": "rol",
        "tipo": "seleccion",
        "etiqueta": "Rol",
        "obligatorio": true,
        "opciones": [
          "Estudiante",
          "Docente"
        ],
        "reglas": {
          "min": null,
          "max": null,
          "patron": null
        },
        "visible_si": null
      },
      {
        "id": "curso",
        "tipo": "texto",
        "etiqueta": "Curso",
        "obligatorio": true,
        "opciones": [],
        "reglas": {
          "min": null,
          "max": null,
          "patron": null
        },
        "visible_si": {
          "campo_id": "rol",
          "valor": "Estudiante"
        }
      }
    ]
  }
}

assert {
  res.status: eq 404
}
