meta {
  name: Responder (201)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/f/{{codigo}}/respuestas
  body: json
  auth: none
}

headers {
  Origin: {{origin}}
}

body:json {
  {
    "valores": {
